{
  "description": "在会话启动时保护标题基线，提交提示词时确认或应用三段式标题；桌面端写入标题文件后立即改名",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-title.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-title.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "ccd_session_mgmt",
            "tool": "set_session_title",
            "input": {
              "session_id": "self",
              "title": "${tool_input.content}"
            },
            "if": "Write(~/.cc-session-titles/**)"
          }
        ]
      }
    ]
  }
}
