{
  "name": "agent-session-titles",
  "version": "0.5.0",
  "description": "安装支持中英文的 Codex 与 Claude Code 本地会话标题插件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panda-z519/agent-session-titles.git"
  },
  "homepage": "https://github.com/panda-z519/agent-session-titles#readme",
  "bin": {
    "agent-session-titles": "bin/codex-session-titles.cjs",
    "codex-session-titles": "bin/codex-session-titles.cjs"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    "bin/",
    "claude-marketplace/",
    "plugins/",
    "scripts/",
    "AGENT_INSTALL.md",
    "README.en.md",
    "使用说明.md",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs && python3 claude-marketplace/plugins/claude-session-titles/tests/test-session-title.py && python3 plugins/codex-session-titles/tests/test-session-title-state.py"
  },
  "engines": {
    "node": ">=20"
  },
  "os": ["darwin", "linux"],
  "keywords": ["codex", "claude-code", "plugin", "session-title", "hooks"]
}
