{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-session-titles",
  "version": "0.2.0",
  "description": "为 Codex 桌面端本地会话自动维护三段式中文标题。",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "会话标题自动更新",
        "shortDescription": "自动维护三段式会话标题",
        "longDescription": "在本地 Codex 会话中记录初始需求，并随阶段更新标题。",
        "category": "Productivity",
        "capabilities": ["Read", "Write"]
      }
    }
  }
}
